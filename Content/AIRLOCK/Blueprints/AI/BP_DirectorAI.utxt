				"Object:/Game/AIRLOCK/Blueprints/AI/BP_DirectorAI.SKEL_BP_DirectorAI_C:ReceiveActorBeginOverlap",
				[
					[
						"Category",
						"Collision"
					],
					[
						"Comment",
						"/** \n\t *\tEvent when this actor overlaps another actor, for example a player walking into a trigger.\n\t *\tFor events when objects have a blocking collision, for example a player hitting a wall, see 'Hit' events.\n\t *\t@note Components on both this and the other Actor must have bGenerateOverlapEvents set to true to generate overlap events.\n\t */"
					],
					[
						"DisplayName",
						"ActorBeginOverlap"
					],
					[
						"ModuleRelativePath",
						"Classes/GameFramework/Actor.h"
					],
					[
						"ToolTip",
						"Event when this actor overlaps another actor, for example a player walking into a trigger.\nFor events when objects have a blocking collision, for example a player hitting a wall, see 'Hit' events.\n@note Components on both this and the other Actor must have bGenerateOverlapEvents set to true to generate overlap events."
					]
				]
			],
